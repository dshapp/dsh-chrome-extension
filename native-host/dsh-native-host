#!/bin/bash
# 开发用 launcher(install.sh 安装时会另写一份钉死绝对路径的)。Chrome 以精简 PATH
# 启动 native host,所以按常见安装位置找 node,找不到再问登录 shell —— 与 Mac 端
# "node 以用户终端为准"一致,node 换装位置(Homebrew ↔ /usr/local)后不会失效。
for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
  [ -x "$candidate" ] && exec "$candidate" "/Users/user/dshapp/dsh-chrome-extension/native-host/dsh-native-host.js"
done
NODE_BIN="$(/bin/zsh -lic 'command -v node' 2>/dev/null | tail -n 1)"
[ -n "$NODE_BIN" ] && exec "$NODE_BIN" "/Users/user/dshapp/dsh-chrome-extension/native-host/dsh-native-host.js"
echo "dsh-native-host: node not found" >&2
exit 127
